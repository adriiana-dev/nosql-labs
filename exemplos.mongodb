// Exibir os bancos de dados
show databases

// Criar / Selecionar banco de dados
use streaming_musica

// Criar nova collection
db.createCollection("faixas")

// Mostrar todas as collections
show collections

// Mostrar todos os documentos/objetos
db.faixas.find()

// Inserir apenas 1 document (objeto com array e objeto embutido)
db.faixas.insertOne({
  "titulo": "Bohemian Rhapsody",
  "artista": "Queen",
  "duracao_segundos": 354,
  "generos": ["Rock Progressivo", "Hard Rock", "Ópera"],
  "album": {
    "nome": "A Night at the Opera",
    "ano_lancamento": 1975,
    "gravadora": "EMI Records"
  }
})

// Inserir muitos documents de uma vez
db.faixas.insertMany([
  { "titulo": "Gostava Tanto de Você", "artista": "Tim Maia" },
  { "titulo": "Creep", "artista": "Radiohead" },
  { "titulo": "Na hora do almoço", "artista": "Belchior" },
  { "titulo": "Billie Jean", "artista": "Michael Jackson" },
  { "titulo": "Apenas Um Rapaz Latino Americano", "artista": "Belchior" }
  { "titulo": "Eu Te Devoro", "artista": "Djavan" },
])

// Buscar pelo campo
db.faixas.find({ "titulo": "Gostava Tanto de Você" })

// Buscar pelo identificador único
db.faixas.find({ _id: ObjectId('664fc8b1a3d94e21a8f90c44') })
